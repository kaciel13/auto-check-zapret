<Window x:Class="AutoCheckZapret.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="{StaticResource TrayAppIcon}"
        Title="AutoCheckZapret" Height="800" Width="720" MinHeight="500" MinWidth="430"
        Background="Transparent" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" AllowsTransparency="False" 
        FontFamily="{StaticResource Montserrat}"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Общий эффект тени -->
        <DropShadowEffect x:Key="CommonDropShadow" Color="Black" BlurRadius="4" Opacity="0.25" Direction="-90"/>

        <!-- Базовый стиль для круглых кнопок управления окном -->
        <Style x:Key="WindowControlButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="100" Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B3030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Базовый стиль для функциональных кнопок -->
        <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect" Value="{StaticResource CommonDropShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#266D39"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B3030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChooseButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="Effect" Value="{StaticResource CommonDropShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#303030"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Height="34"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding ItemTemplate}"
                                          Foreground="#FEFEFE"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          Padding="10,0,0,0">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="5"
                                                            Height="34">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="40"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter x:Name="ContentSite"
                                                                              Grid.Column="0"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"
                                                                              Margin="10,0,0,0"/>
                                                            <Image x:Name="Icon" Grid.Column="1" Source="{StaticResource ToggleIcon}" Height="16" Width="16" Margin="0,3,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#555555"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#555555"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                            <Setter Property="Foreground" Value="#585858"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="False"
                                   Focusable="False">
                                <Border Background="#404040"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="0,0,5,5"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для консоли -->
        <Style x:Key="ConsoleViewerStyle" TargetType="FlowDocumentScrollViewer">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Paragraph">
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      CornerRadius="5"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5,5,5,5"
                      UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="5" Background="#222222">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна -->
            <Border Background="#222222" Height="50" VerticalAlignment="Top" Padding="10,5,10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Image Source="{StaticResource AppIcon}" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <Label x:Name="lbTitle" VerticalAlignment="Center" Foreground="#FEFEFE" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="btnMinimizeWindow" Margin="0,0,5,0" Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click">
                            <Image Source="{StaticResource ViewOffIcon}" Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="btnToggleFullscreen" Margin="0,0,5,0" Style="{StaticResource MaximizeButtonStyle}" Click="MaximizeButton_Click">
                            <Image Source="{StaticResource MaximizeIcon}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="btnCloseWindow" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                            <Image Source="{StaticResource CloseIcon}" Width="15" Height="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная область -->
            <Border Grid.Row="1" Padding="10,0,10,0" Margin="0,12,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель выбора версии и действий -->
                    <Grid Grid.Row="0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cbVersions"
                                  Grid.Column="0"
                                  MinWidth="44"
                                  Style="{StaticResource CustomComboBoxStyle}"
                                  FontSize="16"
                                  SelectionChanged="VersionsComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" Margin="0,0,10,0"/>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Text" Value="{Binding BypassMethodName, StringFormat='[Скачана] {0}'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button x:Name="btnDownload" Margin="0,0,5,0" Style="{StaticResource DownloadButtonStyle}" Click="DownloadButton_Click">
                                <Image Source="{StaticResource DownloadIcon}" Width="24" Height="24"/>
                            </Button>
                            <Button x:Name="btnDelete" Style="{StaticResource DeleteButtonStyle}" Click="DeleteButton_Click">
                                <Image Source="{StaticResource CloseIcon}" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Консольный вывод -->
                    <Border Grid.Row="1" CornerRadius="5" Background="#1B1B1B" Margin="0,10,0,10">
                        <FlowDocumentScrollViewer x:Name="fdsViewerConsole" Style="{StaticResource ConsoleViewerStyle}"/>
                    </Border>

                    <!-- Кнопка выбора/запуска -->
                    <Button x:Name="btnStartStop" Grid.Row="2" Margin="0,0,0,10" Style="{StaticResource ChooseButtonStyle}" Click="StartStopButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>