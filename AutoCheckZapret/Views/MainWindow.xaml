<Window x:Class="AutoCheckZapret.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCheckZapret"
        mc:Ignorable="d"
        Icon="{StaticResource TrayAppIcon}"
        Title="AutoCheckZapret" Height="800" Width="720" MinHeight="500" MinWidth="430"
        Background="Transparent" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" AllowsTransparency="False" FontFamily="{StaticResource Montserrat}">

    <!-- Ресурсы окна: общие стили и эффекты -->
    <Window.Resources>
        <!-- Общий эффект тени для кнопок и комбобокса -->
        <DropShadowEffect x:Key="CommonDropShadow" Color="Black" BlurRadius="4" Opacity="0.25" Direction="-90"/>

        <!-- Базовый стиль для круглых кнопок управления окном (свернуть, развернуть, закрыть) -->
        <Style x:Key="WindowControlButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="100" Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Конкретные стили для кнопок управления окном (отличаются только hover-цветом) -->
        <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B3030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Базовый стиль для функциональных кнопок (скачать, удалить, выбрать метод) -->
        <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect" Value="{StaticResource CommonDropShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для конкретных функциональных кнопок -->
        <Style x:Key="DownloadButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#266D39"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B3030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChooseButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ComboBox (выпадающий список версий) -->
        <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="Effect" Value="{StaticResource CommonDropShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#303030"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Height="34"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding ItemTemplate}"
                                          Foreground="#FEFEFE"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          Padding="10,0,0,0">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="5"
                                                            Height="34">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="40"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter x:Name="ContentSite"
                                                                              Grid.Column="0"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"
                                                                              Margin="10,0,0,0"/>
                                                            <Image x:Name="Icon" Grid.Column="1" Source="{StaticResource ToggleIcon}" Height="16" Width="16" Margin="0,3,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#555555"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#555555"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                                                            <Setter Property="Background" Value="#242424"/>
                                                            <Setter Property="Foreground" Value="#585858"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="False"
                                   Focusable="False">
                                <Border Background="#404040"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="0,0,5,5"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--Консоль-->
        <Style x:Key="ConsoleViewerStyle" TargetType="FlowDocumentScrollViewer">
            <!-- Базовые сеттеры -->
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>

            <Style.Triggers>
                <!-- При наведении мыши -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <!-- При получении фокуса -->
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <!-- более заметная рамка -->
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Paragraph">
            <Setter Property="FontFamily" Value="{StaticResource TheMagicOfDots}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <!-- отступ между строками -->
        </Style>
    </Window.Resources>

    <!-- Настройка кастомного оформления окна: заголовок высотой 50px, скругленные углы -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      CornerRadius="5"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5,5,5,5"
                      UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <!-- Основной контейнер с фоном и скруглением -->
    <Border CornerRadius="5" Background="#222222">
        <Grid x:Name="MainGrid" AllowDrop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна: перетаскивание, заголовок, кнопки управления -->
            <Border x:Name="DragHeader" Background="#222222" Height="50" VerticalAlignment="Top" Padding="10,5,10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип и название приложения -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Image Source="{StaticResource AppIcon}" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <Label x:Name="lbTitle" VerticalAlignment="Center" Foreground="#FEFEFE"  Content="{Binding AppNameWithVersion}" FontSize="14"/>
                    </StackPanel>

                    <!-- Кнопки управления окном -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="btnMinimizeWindow" Margin="0,0,5,0"
                                Style="{StaticResource MinimizeButtonStyle}"
                                Command="{Binding MinimizeWindowCommand}">
                            <Image Source="{StaticResource ViewOffIcon}" Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="btnToggleFullscreen" Margin="0,0,5,0"
                                Style="{StaticResource MaximizeButtonStyle}"
                                Command="{Binding MaximizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image Source="{StaticResource MaximizeIcon}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="btnCloseWindow" 
                                Style="{StaticResource CloseButtonStyle}"
                                Command="{Binding ShutdownApplicationCommand}">
                            <Image Source="{StaticResource CloseIcon}" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная область контента -->
            <Border Grid.Row="1" Padding="10,0,10,0" Margin="0,12,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель выбора версии и действий -->
                    <Grid Grid.Row="0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Выпадающий список версий -->
                        <ComboBox x:Name="cbxZapretVersions"
                                  Grid.Column="0"
                                  MinWidth="44"
                                  ItemsSource="{Binding ZapretVersions}"
                                  SelectedItem="{Binding SelectedZapretVersion}"
                                  IsEnabled="{Binding HasFetchedZapretVersions}"
                                  Style="{StaticResource CustomComboBoxStyle}" FontSize="16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Number}" Margin="0,0,10,0"/>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Text" Value="Скачано"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Кнопки скачивания и удаления -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button x:Name="btnDownloadZapretVersion" Margin="0,0,5,0"
                                    IsEnabled="{Binding CanDownloadZapretVersion}"
                                    Command="{Binding DownloadZapretVersionCommand}"
                                    Style="{StaticResource DownloadButtonStyle}">
                                <Image Source="{StaticResource DownloadIcon}" Width="24" Height="24"/>
                            </Button>
                            <Button x:Name="btnDeleteZapretVersion"
                                    IsEnabled="{Binding CanDeleteOrWorkWithZapretVersion}"
                                    Command="{Binding DeleteZapretVersionCommand}"
                                    Style="{StaticResource DeleteButtonStyle}">
                                <Image Source="{StaticResource CloseIcon}" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Консольный вывод -->
                    <Border Grid.Row="1" CornerRadius="5" Background="#1B1B1B" Margin="0,10,0,10">
                        <FlowDocumentScrollViewer x:Name="fdsViewerConsole" 
                                Style="{StaticResource ConsoleViewerStyle}" Document="{Binding LogDocument}"/>
                    </Border>

                    <!-- Кнопка выбора метода обхода -->
                    <Button Grid.Row="2" Content="{Binding ChooseBypassMethodButtonContent}" Margin="0,0,0,10"
                            IsEnabled="{Binding CanDeleteOrWorkWithZapretVersion}"
                            Style="{StaticResource ChooseButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>