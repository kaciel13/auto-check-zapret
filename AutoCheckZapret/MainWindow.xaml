<Window x:Class="AutoCheckZapret.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCheckZapret"
        mc:Ignorable="d"
        Title="AutoCheckZapret" Height="800" Width="720" MinHeight="500" MinWidth="430" Background="#FFD6D6D6" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="710*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="675*"/>
        </Grid.RowDefinitions>
        <Border Background="#FF8B8A8A" MinHeight="50" Height="50" VerticalAlignment="Center" Padding="10,5,10,5" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>


                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Rectangle Fill="#FFD84343" Width="36" Height="36" Margin="0,0,5,0"/>
                    <Label VerticalAlignment="Center">AutoCheckZapret v2.0.0</Label>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="34" Height="34" Content="0" Margin="0,0,5,0" />
                    <Button Width="34" Height="34" Content="_" Margin="0,0,5,0" />
                    <Button Width="34" Height="34" Content="X"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="10,0,10,0" Margin="0,12,0,2" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="44" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" SelectionChanged="ComboBox_SelectionChanged" Height="44" MinWidth="44" MinHeight="44">
                        <ComboBox.Items>
                            <TextBlock Text="Инпут"/>
                        </ComboBox.Items>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                        <Button Content="->" Width="44" Height="44" Margin="0,0,5,0"/>
                        <Button Content="X" Width="44" Height="44"/>
                    </StackPanel>
                </Grid>

                <TextBox  Grid.Row="1" Text="Консоль" Margin="0,10,0,10" Foreground="#FFDAD8D8" Background="#FF060606" CaretBrush="Gainsboro"/>

                <Button Grid.Row="2" Content="Подобрать zapret" Margin="0,0,0,10" Height="37" BorderThickness="0,0,0,0" MinWidth="44" MinHeight="44" MaxHeight="44" Background="#FFABABAB" BorderBrush="#FF525252"/>
            </Grid>
        </Border>
    </Grid>
</Window>
